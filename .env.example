# --- apps/api ---
PORT=8787
# Where full-page screenshots are written (relative paths resolve from apps/api)
SCREENSHOT_DIR=.data/screenshots
# Public base URL of the API, used to build absolute screenshot URLs
PUBLIC_BASE_URL=http://localhost:8787
# Playwright navigation budget (ms)
RENDER_TIMEOUT_MS=45000
# Max elements captured per page (guards against enormous DOMs)
MAX_ELEMENTS=4000

# --- optional free third-party APIs (feature 2) ---
# Nu HTML Checker - free, no key required
NU_VALIDATOR_URL=https://validator.w3.org/nu/
# LanguageTool public API - free tier, heavily rate limited. Gated behind a request flag.
LANGUAGETOOL_URL=https://api.languagetool.org/v2/check
LANGUAGETOOL_LANG=en-US

# --- apps/web ---
VITE_API_BASE_URL=http://localhost:8787
