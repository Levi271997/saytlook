{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "module": "ES2022",
    "moduleResolution": "bundler",
    // extract.ts runs inside the target page via page.evaluate, so this package
    // legitimately needs DOM types. packages/analyzer stays DOM-free.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "declaration": false,
    "declarationMap": false
  },
  "include": ["src"]
}
